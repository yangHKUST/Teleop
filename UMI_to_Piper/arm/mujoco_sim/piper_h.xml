<mujoco model="piper_h">
  <compiler angle="radian" meshdir="../../agx_arm_urdf/piper_h/meshes"/>

  <!-- Modified-DH kinematic chain (matches the real-arm firmware / piper_sdk /
       piper_pinocchio.py), so data.qpos[:6] == real-arm joint angles and the
       link6 body frame == the real-arm end-effector 6D pose exactly.

       The stock URDF wrist is ~1 cm longer than MDH (URDF link3 0.25575 m /
       link5 0.0963 m vs MDH 0.25075 m / 0.091 m).  The body frames below use
       the MDH link lengths; each link4/link5/link6 mesh keeps a small pos
       offset so the visuals still line up with the URDF-authored STL meshes.

       Zero gravity: this is a joint-trajectory teleop demo, not a physics
       reachability study. Removing gravity keeps the position servos stable
       (no sag/fall) so the sim arm tracks the commanded pose cleanly. -->
  <option gravity="0 0 0"/>

  <asset>
    <mesh name="base_link" file="base_link.stl"/>
    <mesh name="link1" file="link1.stl"/>
    <mesh name="link2" file="link2.stl"/>
    <mesh name="link3" file="link3.stl"/>
    <mesh name="link4" file="link4.stl"/>
    <mesh name="link5" file="link5.stl"/>
    <mesh name="link6" file="link6.stl"/>
    <mesh name="flange" file="flange.stl"/>
    <mesh name="gripper_base" file="gripper_base.stl"/>
    <mesh name="gripper_link1" file="gripper_link1.stl"/>
    <mesh name="gripper_link2" file="gripper_link2.stl"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <geom type="plane" size="1.2 1.2 0.05" rgba="0.85 0.85 0.85 1"/>

    <!-- Ghost target marker for keyboard Cartesian teleop: a mocap body whose
         pose the bridge writes from data.mocap_pos/mocap_quat. Purely visual,
         not part of the kinematic chain. -->
    <body name="target_marker" mocap="true" pos="0.35 0 0.3">
      <geom type="sphere" size="0.03" rgba="0.2 0.9 0.2 0.7"/>
      <geom type="sphere" size="0.05" rgba="0.2 0.9 0.2 0.18"/>
      <geom type="cylinder" size="0.003" fromto="0 0 0 0.06 0 0" rgba="1 0 0 0.8"/>
      <geom type="cylinder" size="0.003" fromto="0 0 0 0 0.06 0" rgba="0 1 0 0.8"/>
      <geom type="cylinder" size="0.003" fromto="0 0 0 0 0 0.06" rgba="0 0 1 0.8"/>
    </body>

    <body name="base_link" pos="0 0 0">
      <inertial pos="-0.004736 0.000026 0.041452" mass="1.02" diaginertia="0.00267433 0.00282612 0.00089624"/>
      <geom type="mesh" mesh="base_link" rgba="0.45 0.45 0.5 1"/>

      <body name="link1" pos="0 0 0.123">
        <joint name="joint1" axis="0 0 1" range="-2.617994 2.617994"/>
        <inertial pos="0.00032 -0.00041 -0.00348" mass="0.71" diaginertia="0.00050027 0.00040879 0.00045802"/>
        <geom type="mesh" mesh="link1" rgba="0.7 0.7 0.7 1"/>

        <body name="link2" pos="0 0 0" quat="-0.0479710 0.0479709 0.7054777 0.7054777">
          <joint name="joint2" axis="0 0 1" range="0 3.141593"/>
          <inertial pos="0.21852 -0.00861 0.00126" mass="1.16" diaginertia="0.00111915 0.06763251 0.067559"/>
          <geom type="mesh" mesh="link2" rgba="0.7 0.7 0.7 1"/>

          <body name="link3" pos="0.28503 0 0" quat="0.6240160 0.0000000 0.0000000 -0.7814116">
            <joint name="joint3" axis="0 0 1" range="-2.967060 0"/>
            <inertial pos="-0.01999 -0.14808 -0.00053" mass="0.5" diaginertia="0.01347608 0.00046377 0.01363321"/>
            <geom type="mesh" mesh="link3" rgba="0.7 0.7 0.7 1"/>

            <body name="link4" pos="-0.02198 -0.25075 0" quat="0.7071068 0.7071068 0.0000000 0.0000000">
              <joint name="joint4" axis="0 0 1" range="-1.745330 1.745330"/>
              <inertial pos="0.00013 -0.00076 0.00106" mass="0.38" diaginertia="0.00017844 0.00018914 0.00014613"/>
              <geom type="mesh" mesh="link4" pos="0 0 0.005" rgba="0.7 0.7 0.7 1"/>

              <body name="link5" pos="0 0 0" quat="0.7071068 -0.7071068 0.0000000 0.0000000">
                <joint name="joint5" axis="0 0 1" range="-1.221730 1.221730"/>
                <inertial pos="0.00018 -0.06604 -0.00227" mass="0.39" diaginertia="0.00172318 0.00017936 0.00171172"/>
                <geom type="mesh" mesh="link5" pos="0 -0.005 0" rgba="0.7 0.7 0.7 1"/>

                <body name="link6" pos="0 -0.091 0" quat="0.7071068 0.7071068 0.0000000 0.0000000">
                  <joint name="joint6" axis="0 0 1" range="-3.141593 3.141593"/>
                  <inertial pos="-0.00003 0.00006 0.0083" mass="0.05" diaginertia="0.00152112 0.00138626 0.00031152"/>
                  <geom type="mesh" mesh="link6" pos="0 0 0.0103" rgba="0.9 0.55 0.2 1"/>

                  <!-- 夹爪（数字孪生可视化）：flange + gripper_base 固定，两手指 slide 关节
                       沿 ±Y 开合。几何/挂载完全复刻
                       agx_arm_urdf/piper_h/urdf/piper_h_with_gripper_description.xacro：
                       flange 在 link6 原点(0 0 0.0103 对齐网格偏移)，gripper_base 在 flange
                       +0.0045，两手指在 gripper_base +0.138 处、rpy=Rx(90°)(手指2 再 Rz(-180°))，
                       axis 子系 "0 0 ±1"。qpos[6]=+w/2、qpos[7]=-w/2（运动学傀儡，无 actuator）。 -->
                  <body name="flange" pos="0 0 0.0103">
                    <geom type="mesh" mesh="flange" rgba="0.6 0.6 0.65 1"/>
                    <body name="gripper_base" pos="0 0 0.0045">
                      <geom type="mesh" mesh="gripper_base" rgba="0.35 0.35 0.4 1"/>
                      <body name="gripper_finger1" pos="0 0 0.138" quat="0.7071068 0.7071068 0 0">
                        <joint name="gripper_slide1" type="slide" axis="0 0 1" range="0 0.05"/>
                        <geom type="mesh" mesh="gripper_link1" rgba="0.65 0.65 0.7 1"/>
                      </body>
                      <body name="gripper_finger2" pos="0 0 0.138" quat="0 0 0.7071068 0.7071068">
                        <joint name="gripper_slide2" type="slide" axis="0 0 -1" range="-0.05 0"/>
                        <geom type="mesh" mesh="gripper_link2" rgba="0.65 0.65 0.7 1"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Kinematic puppet: no actuators. The bridge writes data.qpos directly from
       the teleop's joint targets (agx_arm_teleop already does smoothing, IK and
       limit-clamping), so the sim tracks the commanded pose exactly with no
       servo lag or dynamics instability. -->
  <keyframe>
    <key name="home" qpos="0 0.7 -0.62 0 0 0 0 0"/>
  </keyframe>
</mujoco>
